      "id": "1622440e-5cbf-469c-ac87-ae45ee5b5960",
      "name": "GCP 요금 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        240
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "9t9YoSndAdJ5SaFT",
          "name": "GCP Billing API Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Azure Retail Prices → 공통 스키마 (Linux, 서울 리전)\nconst SPECS = {\n  'Standard_D4s_v5':  { family: 'Dsv5 (Intel)', vcpu: 4, mem: 16 },\n  'Standard_D4as_v5': { family: 'Dasv5 (AMD)',  vcpu: 4, mem: 16 },\n};\nconst items = $input.all().flatMap(i => i.json.Items || []);\nif (!items.length) return []; // 조회 실패 시 빈 결과\n\nconst today = $now.setZone('Asia/Seoul').toFormat('yyyy-MM-dd');\nconst out = [];\nconst seen = new Set();\nfor (const it of items) {\n  if (!/^Virtual Machines /i.test(it.productName || '')) continue; // VM만 (Cloud Services 제외)\n  if (/windows/i.test(it.productName || '')) continue;   // Linux만\n  if (/low priority/i.test(it.skuName || '')) continue;  // 구형 Low Priority 제외\n  const spec = SPECS[it.armSkuName];\n  if (!spec) continue;\n  const pricing = /spot/i.test(it.skuName || '') ? 'Spot' : 'OnDemand';\n  const k = `${it.armSkuName}|${pricing}`;\n  if (seen.has(k)) continue; // 중복 방지\n  seen.add(k);\n  const hourly = Number(it.retailPrice);\n  out.push({ json: {\n    date: today,\n    provider: 'Azure',\n    instance: it.armSkuName,\n    family: spec.family,\n    vcpu: spec.vcpu,\n    memory_gb: spec.mem,\n    region: 'koreacentral (Seoul)',\n    pricing,\n    hourly_usd: +hourly.toFixed(6),\n    monthly_usd: +(hourly * 730).toFixed(2),\n    source: 'Azure Retail Prices API',\n  }});\n}\nreturn out;"
      },
      "id": "ca544d64-ec55-46b2-8c5f-58d1caf4c052",
      "name": "Azure 정규화",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// GCP Cloud Billing Catalog (Compute Engine SKU) → 공통 스키마\n// 머신 가격 = vCPU 단가 × vCPU 수 + 메모리(GiB) 단가 × GiB 수\nconst REGION = 'asia-northeast3'; // 서울\nconst MACHINES = [\n  { fam: 'N2', instance: 'n2-standard-4', family: 'N2 (Intel)',       vcpu: 4, mem: 16 },\n  { fam: 'E2', instance: 'e2-standard-4', family: 'E2 (Cost-optimized)', vcpu: 4, mem: 16 },\n];\nconst skus = $input.all().flatMap(i => i.json.skus || []);\nif (!skus.length) return []; // 조회 실패 시 빈 결과\n\nconst unitPrice = s => {\n  const tiers = s?.pricingInfo?.[0]?.pricingExpression?.tieredRates || [];\n  const t = tiers[tiers.length - 1];\n  if (!t) return null;\n  return Number(t.unitPrice.units || 0) + (t.unitPrice.nanos || 0) / 1e9;\n};\nconst findSku = (fam, kind, usageType) => skus.find(s =>\n  s.category?.usageType === usageType &&\n  (s.serviceRegions || []).includes(REGION) &&\n  new RegExp(`(^|\\\\s)${fam} Instance ${kind} running in`, 'i').test(s.description || '') &&\n  !/custom|sole tenancy|extended|commit/i.test(s.description || '')\n);\n\nconst today = $now.setZone('Asia/Seoul').toFormat('yyyy-MM-dd');\nconst out = [];\nfor (const m of MACHINES) {\n  for (const [usageType, pricing] of [['OnDemand', 'OnDemand'], ['Preemptible', 'Spot']]) {\n    const core = findSku(m.fam, 'Core', usageType);\n    const ram  = findSku(m.fam, 'Ram',  usageType);\n    if (!core || !ram) continue;\n    const hourly = m.vcpu * unitPrice(core) + m.mem * unitPrice(ram);\n    out.push({ json: {\n      date: today,\n      provider: 'GCP',\n      instance: m.instance,\n      family: m.family,\n      vcpu: m.vcpu,\n      memory_gb: m.mem,\n      region: 'asia-northeast3 (Seoul)',\n      pricing,\n      hourly_usd: +hourly.toFixed(6),\n      monthly_usd: +(hourly * 730).toFixed(2),\n      source: 'GCP Cloud Billing Catalog API',\n    }});\n  }\n}\nreturn out;"
      },
