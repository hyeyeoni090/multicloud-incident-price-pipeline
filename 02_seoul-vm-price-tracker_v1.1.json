    {
      "parameters": {
        "jsCode": "// 전일 대비 변동 계산 + 최저가 표시\nconst now = $now.setZone('Asia/Seoul');\nconst current = $('가격 합치기').all().map(i => i.json).filter(r => r.provider);\nconst history = $input.all().map(i => i.json).filter(r => r.price_key);\nconst seriesOf = r => `${r.provider}|${r.instance}|${r.pricing}`;\n\nconst out = current.map(r => {\n  const series = seriesOf(r);\n  const prev = history\n    .filter(h => seriesOf(h) === series && String(h.date) < r.date)\n    .sort((a, b) => String(b.date).localeCompare(String(a.date)))[0];\n  const prevHourly = prev ? Number(prev.hourly_usd) : null;\n  const changed = prevHourly !== null && Math.abs(r.hourly_usd - prevHourly) > 1e-9;\n  return { json: {\n    price_key: `${r.date}|${series}`,\n    ...r,\n    prev_hourly_usd: prevHourly ?? '',\n    change_pct: prevHourly ? +(((r.hourly_usd - prevHourly) / prevHourly) * 100).toFixed(3) : '',\n    cheapest: false,\n    changed,\n    collected_at: now.toISO(),\n  }};\n});\n\n// 같은 과금 방식(OnDemand / Spot) 안에서 가장 싼 것 표시\nfor (const p of ['OnDemand', 'Spot']) {\n  const group = out.filter(o => o.json.pricing === p);\n  if (!group.length) continue;\n  const min = Math.min(...group.map(o => o.json.hourly_usd));\n  group.forEach(o => { o.json.cheapest = o.json.hourly_usd === min; });\n}\nreturn out;"
      },
