    {
      "parameters": {
        "url": "https://cloudbilling.googleapis.com/v1/services/6F81-5844-456A/skus",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
