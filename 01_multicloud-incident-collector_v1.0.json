    {
      "parameters": {
        "url": "https://azure.status.microsoft/en-us/status/feed/",
        "options": {}
      },
      "id": "ce1db60c-903e-4e67-8d4c-5c5e840ed9dd",
      "name": "Azure 장애 조회",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        0,
        400
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// GCP incidents.json → 공통 스키마 (최근 90일)\nconst DAYS = 90;\nconst cutoff = Date.now() - DAYS * 864e5;\nconst raw = $input.all().flatMap(it => Array.isArray(it.json) ? it.json : [it.json]);\nif (!raw.length || raw[0].error) return []; // 조회 실패 → meta 없음 → 종료 처리 안 함\n\nconst out = [{ json: { _meta: 'GCP' } }];\nfor (const i of raw) {\n  if (!i || !i.id || !i.begin) continue;\n  if (new Date(i.begin).getTime() < cutoff) continue;\n  const locs = [...(i.currently_affected_locations || []), ...(i.previously_affected_locations || [])].map(l => l.id);\n  const products = (i.affected_products || []).map(p => p.title);\n  out.push({ json: {\n    incident_key: `GCP:${i.id}`,\n    provider: 'GCP',\n    service: i.service_name === 'Multiple Products' ? `Multiple (${products.length})` : i.service_name,\n    regions: [...new Set(locs)].join(', ') || 'global',\n    severity: i.severity || '',\n    status: i.end ? 'resolved' : 'ongoing',\n    title: (i.external_desc || '').slice(0, 200),\n    started_at: new Date(i.begin).toISOString(),\n    ended_at: i.end ? new Date(i.end).toISOString() : '',\n    url: `https://status.cloud.google.com/${i.uri}`\n  }});\n}\nreturn out;"
      },
      "id": "62b6c098-1761-4c81-a950-2c398f3e5419",
      "name": "GCP 정규화",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// AWS currentevents (UTF-16 인코딩!) → 공통 스키마\nconst item = $input.first();\nif (!item || !item.binary || !item.binary.data) return []; // 조회 실패\n\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nlet text;\nif (buf[0] === 0xFF && buf[1] === 0xFE) text = buf.subarray(2).toString('utf16le');\nelse if (buf[0] === 0xFE && buf[1] === 0xFF) { const b = Buffer.from(buf.subarray(2)); b.swap16(); text = b.toString('utf16le'); }\nelse if (buf.length > 1 && buf[1] === 0x00) text = buf.toString('utf16le');\nelse text = buf.toString('utf8');\ntext = text.replace(/^\\uFEFF/, '').trim();\nconst events = text ? JSON.parse(text) : [];\n\nconst SEV = { '1': 'informational', '2': 'degradation', '3': 'disruption' };\nconst out = [{ json: { _meta: 'AWS' } }];\nfor (const e of events) {\n  const log = e.event_log || [];\n  const last = log[log.length - 1] || {};\n  const regionCode = (e.arn || '').split(':')[3] || '';\n  out.push({ json: {\n    incident_key: `AWS:${e.arn}`,\n    provider: 'AWS',\n    service: e.service_name || e.service,\n    regions: [e.region_name, regionCode].filter(Boolean).join(' / ') || 'global',\n    severity: SEV[String(e.status)] || String(e.status || ''),\n    status: 'ongoing',\n    title: `${e.summary || ''} — ${last.summary || ''}`.slice(0, 200),\n    started_at: new Date(Number(e.date) * 1000).toISOString(),\n    ended_at: '',\n    url: 'https://health.aws.amazon.com/health/status'\n  }});\n}\nreturn out;"
      },
      "id": "e920a564-5845-40ca-bab6-11b7aa16344f",
      "name": "AWS 정규화",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "// Azure 상태 RSS → 공통 스키마 (장애 없으면 피드가 비어 있음)\nconst items = $input.all().map(i => i.json);\nif (items.some(i => i.error)) return []; // 조회 실패\n\nconst out = [{ json: { _meta: 'Azure' } }];\nfor (const i of items) {\n  if (!i || !i.title) continue;\n  const text = `${i.title} ${i.contentSnippet || i.content || ''}`;\n  const m = text.match(/\\b(Korea Central|Korea South|East US 2?|West US 2?|West Europe|North Europe|Southeast Asia|East Asia|Japan East)\\b/);\n  out.push({ json: {\n    incident_key: `Azure:${i.guid || i.link || i.title}`,\n    provider: 'Azure',\n    service: (i.title.split(' - ')[0] || i.title).slice(0, 80),\n    regions: m ? m[1] : 'see title',\n    severity: 'n/a',\n    status: 'ongoing',\n    title: i.title.slice(0, 200),\n    started_at: i.pubDate ? new Date(i.pubDate).toISOString() : new Date().toISOString(),\n    ended_at: '',\n    url: i.link || 'https://azure.status.microsoft/en-us/status/'\n  }});\n}\nreturn out;"
      },
