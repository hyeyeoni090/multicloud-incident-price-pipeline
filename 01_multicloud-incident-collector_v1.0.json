      "id": "916efda6-a53c-4751-a772-f1984927ba07",
      "name": "기존 기록 읽기",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        704,
        208
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
