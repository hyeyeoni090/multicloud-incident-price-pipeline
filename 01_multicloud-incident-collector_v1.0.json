    {
      "parameters": {
        "jsCode": "// 신규 / 변경 / 종료 판정 + 알림 대상 표시\nconst now = new Date().toISOString();\nconst merged = $('3사 합치기').all().map(i => i.json);\nconst okProviders = new Set(merged.filter(r => r._meta).map(r => r._meta)); // 조회 성공한 제공사\nconst current = merged.filter(r => r.incident_key);\nconst existing = $input.all().map(i => i.json).filter(r => r.incident_key);\n\nconst exMap = new Map(existing.map(r => [r.incident_key, r]));\nconst curKeys = new Set(current.map(r => r.incident_key));\nconst firstRun = existing.length === 0; // 첫 실행엔 알림 폭탄 방지\nconst WATCH = /seoul|korea|asia-northeast3|ap-northeast-2|koreacentral/i;\nconst dur = (s, e) => (s && e) ? Math.round((new Date(e) - new Date(s)) / 60000) : '';\n\nconst out = [];\nfor (const r of current) {\n  const old = exMap.get(r.incident_key);\n  const row = { ...r, first_seen: (old && old.first_seen) || now, last_seen: now };\n  row.duration_min = dur(row.started_at, row.ended_at);\n  let action = 'unchanged';\n  if (!old) action = 'new';\n  else if (old.status !== row.status || String(old.ended_at || '') !== String(row.ended_at || '')) action = 'updated';\n  const important = ['high', 'disruption'].includes(String(row.severity).toLowerCase()) || WATCH.test(`${row.regions} ${row.title}`);\n  out.push({ json: { ...row, action, alert: action === 'new' && !firstRun && important } });\n}\n\n// AWS·Azure는 '현재 장애'만 공개 → 피드에서 사라지면 종료로 기록 (조회 성공한 경우에만)\nfor (const old of existing) {\n  if (curKeys.has(old.incident_key)) continue;\n  if (old.provider === 'GCP' || old.status === 'resolved') continue;\n  if (!okProviders.has(old.provider)) continue;\n  out.push({ json: { ...old, status: 'resolved', ended_at: now, duration_min: dur(old.started_at, now), last_seen: now, action: 'resolved', alert: false } });\n}\nreturn out;"
      },
